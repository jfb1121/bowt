# compiled binary
/bowt
# test binaries / coverage
*.test
*.out
coverage.*
# local dev DBs (bowt writes ~/.bowt, not the repo — but just in case)
*.db
# local working docs — process/orchestration notes, NOT shipped. Kept out of
# history to avoid git noise. (Prompts under internal/spawn/prompts/ DO ship —
# they're go:embed source.)
/ORCH_CHECKPOINT.md
/PORTING.md
/rfc/
# agent handshake / writeback chatter — always local
subagent/
# per-worktree runtime artifacts bowt writes under .bowt/ (the gate verdict, and
# each lane's captured log + handoff spec). .bowt/gate.sh itself IS tracked — it's
# bowt's own gate hook — so ignore the artifacts by name, not the whole dir.
.bowt/gate.json
.bowt/lane-*.log
.bowt/lane-*.spec.json

# goreleaser build output
dist/

# brag launch-video generation workspace
brag-output/
